<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seprise_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/seprise_nav_bg</item>
        <item name="colorOnPrimaryContainer">@color/seprise_nav_text</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- 3 estilos Figma, agregar cuando haya más variantes -->
    <style name="Text.SePrise.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/seprise_ink</item>
    </style>
    <style name="Text.SePrise.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/seprise_muted</item>
    </style>
    <style name="Widget.SePrise.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
</resources>
