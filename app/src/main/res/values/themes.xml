<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App SIEMPRE en claro: parent Light, no DayNight. El diseño Figma no define modo oscuro,
         y forceDarkAllowed=false evita que el sistema fuerce dark (Android 10+) sobre el claro. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/seprise_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/seprise_nav_bg</item>
        <item name="colorOnPrimaryContainer">@color/seprise_nav_text</item>
        <item name="colorSurface">@color/seprise_surface</item>
        <item name="colorOnSurface">@color/seprise_ink</item>
        <item name="colorOnSurfaceVariant">@color/seprise_muted</item>
        <item name="colorOutline">@color/seprise_outline</item>
        <item name="colorError">@color/seprise_error</item>
        <item name="android:colorBackground">@color/seprise_bg</item>
        <item name="android:windowBackground">@color/seprise_bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- Tipografía SePrise -->
    <style name="Text.SePrise" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/seprise_muted</item>
    </style>
    <style name="Text.SePrise.Title" parent="Text.SePrise">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/seprise_ink</item>
    </style>
    <style name="Text.SePrise.Body" parent="Text.SePrise">
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="Text.SePrise.Subtitle" parent="Text.SePrise">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/seprise_ink</item>
    </style>

    <!-- Widgets SePrise -->
    <style name="Widget.SePrise.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="Widget.SePrise.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/seprise_nav_text</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="Widget.SePrise.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/seprise_ink</item>
        <item name="android:textColorHint">@color/seprise_placeholder</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
</resources>
