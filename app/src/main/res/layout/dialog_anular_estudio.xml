<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anular Estudio"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_blue"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Indique el motivo de anulación (obligatorio):"
        android:textSize="14sp"
        android:textColor="@color/seprise_ink"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_motivo_anulacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:hint="Motivo de la anulación..."
        android:inputType="textMultiLine"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:textColor="@color/seprise_ink" />

</LinearLayout>
