<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/seprise_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_titulo_atencion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Atención Médica"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink" />

    <TextView
        android:id="@+id/tv_medico_atencion_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/seprise_blue"
        android:layout_marginTop="4dp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_buscar_atencion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Buscar por paciente u observaciones..."
            android:textColorHint="@color/seprise_placeholder"
            android:textColor="@color/seprise_ink"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_nav_active"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_cargar_atencion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Cargar Atención"
            android:textSize="13sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/container_atenciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
