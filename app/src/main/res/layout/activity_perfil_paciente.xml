<?xml version="1.0" encoding="utf-8"?>
<!-- paddings son espaciado de layout, no tokens Figma; mover a dimens cuando el diseñador los pase -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cu01_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seprise_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.SePrise.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cu01_perfil_title" />

        <TextView
            style="@style/Text.SePrise.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cu01_perfil_label_usuario" />

        <TextView
            android:id="@+id/cu01_perfil_usuario"
            style="@style/Text.SePrise.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Text.SePrise.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cu01_perfil_label_hc" />

        <TextView
            android:id="@+id/cu01_perfil_hc"
            style="@style/Text.SePrise.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/seprise_ink" />

        <TextView
            style="@style/Text.SePrise.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cu01_perfil_label_empadronamiento" />

        <TextView
            android:id="@+id/cu01_perfil_empadronamiento"
            style="@style/Text.SePrise.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/cu01_perfil_telefono"
            style="@style/Widget.SePrise.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/cu01_perfil_label_telefono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/cu01_perfil_direccion"
            style="@style/Widget.SePrise.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cu01_perfil_label_direccion"
            android:inputType="text" />

        <EditText
            android:id="@+id/cu01_perfil_password"
            style="@style/Widget.SePrise.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cu01_perfil_label_password"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/cu01_perfil_btn_guardar"
            style="@style/Widget.SePrise.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cu01_perfil_btn_guardar" />
    </LinearLayout>
</ScrollView>
