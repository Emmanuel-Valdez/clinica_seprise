<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_nav_active"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_nombre_estudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <TextView
            android:id="@+id/tv_estado_estudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_paciente_estudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/seprise_muted"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tv_fecha_estudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/seprise_blue"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_info_estudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/seprise_placeholder"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_nro_orden_estudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/seprise_muted"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tv_comprobante_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/seprise_blue"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/container_acciones_estudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_marcar_informado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Marcar informado"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_anular_estudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Anular"
            android:textSize="11sp"
            android:layout_marginHorizontal="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_comprobante_retiro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Comprobante"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
