<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_input">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMPROBANTE DE RETIRO"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_blue"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_comprobante_nro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_comprobante_paciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/seprise_ink"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_comprobante_estudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/seprise_ink"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_comprobante_fecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/seprise_ink"
        android:layout_marginBottom="8dp" />

</LinearLayout>
