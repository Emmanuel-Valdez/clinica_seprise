<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_dialog_turno_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/seprise_blue"
            android:text="Sacar Turno" />

        <TextView
            android:id="@+id/tv_dialog_turno_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/seprise_muted"
            android:layout_marginBottom="16dp" />

        <!-- Seleccionar Paciente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paciente:"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <Spinner
            android:id="@+id/spinner_paciente"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Fecha del Turno -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha (AAAA-MM-DD):"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_fecha_turno"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej: 2025-06-15"
            android:inputType="date"
            android:layout_marginBottom="12dp" />

        <!-- Horarios Disponibles de la Agenda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horarios disponibles:"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <Spinner
            android:id="@+id/spinner_horario_disponible"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Es Sobreturno -->
        <CheckBox
            android:id="@+id/cb_es_sobreturno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Es sobreturno"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
