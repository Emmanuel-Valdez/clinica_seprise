<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_insumo_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_blue"
        android:text="Agregar Insumo"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del insumo:"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink" />

    <EditText
        android:id="@+id/et_nombre_insumo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ej: Gasas estériles"
        android:inputType="textCapWords"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stock / Cantidad:"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink" />

    <EditText
        android:id="@+id/et_cantidad_insumo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ej: 50"
        android:inputType="number"
        android:layout_marginBottom="12dp" />

</LinearLayout>
