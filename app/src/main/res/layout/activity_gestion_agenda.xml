<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/seprise_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_titulo_gestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Agendas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink" />

    <TextView
        android:id="@+id/tv_subtitulo_gestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione un médico para cargar o ver su agenda."
        android:textSize="14sp"
        android:textColor="@color/seprise_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/container_medicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

        </LinearLayout>
    </ScrollView>
</LinearLayout>
