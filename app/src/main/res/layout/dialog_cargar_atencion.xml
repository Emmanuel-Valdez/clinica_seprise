<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_dialog_atencion_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/seprise_blue"
            android:text="Cargar Atención de Paciente"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_medico_logueado_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar / Seleccionar Paciente:"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <AutoCompleteTextView
            android:id="@+id/actv_paciente"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombre, apellido o n° empadronamiento..."
            android:completionThreshold="1"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/seprise_ink"
            android:textColorHint="@color/seprise_placeholder"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_paciente_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/seprise_muted"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historia clínica (antecedentes):"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <TextView
            android:id="@+id/tv_hc_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/seprise_ink"
            android:background="@drawable/bg_nav_active"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_turno_dia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/seprise_blue"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnóstico (obligatorio):"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_diagnostico_atencion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ingrese el diagnóstico..."
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicaciones:"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_indicaciones_atencion"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:hint="Tratamiento e indicaciones..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observaciones:"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_observaciones_atencion"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:hint="Notas libres..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duración (Minutos):"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_duracion_atencion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="15"
            android:inputType="number"
            android:text="15"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor de la Consulta ($):"
            android:textStyle="bold"
            android:textColor="@color/seprise_ink" />

        <EditText
            android:id="@+id/et_valor_consulta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej: 15000"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
