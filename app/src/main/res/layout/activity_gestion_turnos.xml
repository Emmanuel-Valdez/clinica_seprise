<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/seprise_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_titulo_gestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Turnos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/seprise_ink" />

    <TextView
        android:id="@+id/tv_subtitulo_gestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione un circuito para solicitar su turno."
        android:textSize="14sp"
        android:textColor="@color/seprise_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- RadioGroup Circuito -->
    <RadioGroup
        android:id="@+id/rg_circuito_turnos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rb_turnos_consultorios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Consultorio Externo"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_turnos_estudios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estudios Clínicos" />
    </RadioGroup>

    <EditText
        android:id="@+id/et_buscar_medico"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Buscar por nombre o servicio..."
        android:textColorHint="@color/seprise_placeholder"
        android:textColor="@color/seprise_ink"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_nav_active"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/container_medicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
